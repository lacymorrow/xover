	"build": {
		"appId": "com.lacymorrow.crossover",
		"copyright": "Copyright © Lacy Morrow",
		"productName": "CrossOver",
		"asar": true,
		"asarUnpack": "**\\*.{node,dll}",
		"files": [
			"dist/",
			"node_modules/",
			"package.json"
		],
		"afterSign": ".erb/scripts/notarize.js",
		"mac": {
			"appId": "com.lacymorrow.crossover",
			"category": "public.app-category.games",
			"type": "distribution",
			"hardenedRuntime": true,
			"entitlements": "assets/entitlements.mac.plist",
			"entitlementsInherit": "assets/entitlements.mac.plist",
			"gatekeeperAssess": false,
			"artifactName": "${productName}-${version}-mac-${arch}.${ext}"
		},
		"dmg": {
			"contents": [
				{
					"x": 130,
					"y": 220
				},
				{
					"x": 410,
					"y": 220,
					"type": "link",
					"path": "/Applications"
				}
			]
		},
		"linux": {
			"category": "Game",
			"icon": "assets/icons",
			"artifactName": "${productName}-${version}-${arch}.${ext}"
		},
		"win": {
			"appId": "com.lacymorrow.crossover",
			"icon": "assets/icons/icon.ico",
			"target": "nsis"
		},
		"nsis": {
			"unicode": false,
			"artifactName": "${productName}-Installer-${version}.${ext}"
		},
		"appx": {
			"applicationId": "CrossOver",
			"artifactName": "${productName}.${ext}",
			"backgroundColor": "#464646",
			"displayName": "CrossOver",
			"identityName": "2886Fly5.CrossOverElectron",
			"publisher": "CN=C53C0091-1EEB-40B4-8537-082E06A4D328",
			"publisherDisplayName": "Fly5"
		},
		"publish": {
			"provider": "github",
			"owner": "lacymorrow",
			"repo": "crossover"
		}
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
