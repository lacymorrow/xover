  "engines": {
    "node": ">=18.0.0 <=26.0.0"
  },
	"main": "./src/main/main.ts",
	"scripts": {
    "dev": "concurrently -k 'npm:start:preload' 'npm:start:renderer' 'npm:start:main'",
		"build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
		"build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
		"build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
		"build:dll": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
		"postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps",
		"lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "cross-env NODE_ENV=development eslint . --fix --ext .js,.jsx,.ts,.tsx",
		"package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -mwl --publish never && npm run build:dll",
		"package:mw": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -mw --publish never && npm run build:dll",
		"package:mac": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -m --publish never && npm run build:dll",
		"package:linux": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -l --publish never && npm run build:dll",
		"package:windows": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -w --publish never && npm run build:dll",
		"rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main:bundle": "cross-env NODE_ENV=development node -r ts-node/register/transpile-only ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.main.dev.ts --watch",
    "start:main": "cross-env NODE_ENV=development electronmon -r ts-node/register/transpile-only .",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.ts --watch",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register/transpile-only ./node_modules/webpack/bin/webpack.js serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
		"test": "jest",
		"analyze": "ANALYZE=true npm run build",
		"debug-prod": "npx cross-env DEBUG_PROD=true npm run package",
		"release": "np --branch release && yarn build:release",
		"sh:copyexe": "cp dist/CrossOver-[!Portable]*.exe dist/CrossOver.exe",
		"sh:replacespaces": "find dist/ -name 'CrossOver*' -maxdepth 1 -exec bash -c ' mv \"$0\" \"${0// /-}\" ' {} \\;",
		"snap:login:export": "snapcraft export-login --snaps crossover --channels edge,stable -",
		"snap:release": "snapcraft upload --release=stable dist/*.snap",
		"version-bump": "node .erb/scripts/version-bump.js",
		"version-bump:minor": "npx cross-env VERSION_BUMP=minor npm run version-bump",
		"version-bump:major": "npx cross-env VERSION_BUMP=major npm run version-bump",
		"version-bump:patch": "npx cross-env VERSION_BUMP=patch npm run version-bump"
	},
	"browserslist": [
		"extends browserslist-config-erb"
	],
	"prettier": {
		"singleQuote": true,
		"overrides": [
			{
				"files": [
					".prettierrc",
					".eslintrc"
				],
				"options": {
					"parser": "json"
				}
			}
		]
	},
	"jest": {
		"moduleDirectories": [
			"node_modules",
			"release/app/node_modules",
			"src"
		],
		"moduleFileExtensions": [
			"js",
			"jsx",
			"ts",
			"tsx",
			"json"
		],
		"moduleNameMapper": {
			"\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
			"\\.(css|less|sass|scss)$": "identity-obj-proxy"
		},
		"setupFiles": [
			"./.erb/scripts/check-build-exists.ts"
		],
		"testEnvironment": "jsdom",
		"testEnvironmentOptions": {
			"url": "http://localhost/"
		},
		"testPathIgnorePatterns": [
			"release/app/dist",
			".erb/dll"
		],
		"transform": {
			"\\.(ts|tsx|js|jsx)$": "ts-jest"
		}
	},
